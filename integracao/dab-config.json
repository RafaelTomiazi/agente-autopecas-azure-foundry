{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.12/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DAB_CONN')",
    "options": {
      "set-session-context": false
    }
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": false
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "mcp": {
      "enabled": true,
      "path": "/mcp"
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "Unauthenticated"
      },
      "mode": "development"
    },
    "telemetry": {
      "open-telemetry": {
        "enabled": true,
        "endpoint": "@env('OTEL_EXPORTER_OTLP_ENDPOINT')",
        "headers": "@env('OTEL_EXPORTER_OTLP_HEADERS')",
        "service-name": "@env('OTEL_SERVICE_NAME')"
      }
    }
  },
  "autoentities": {},
  "entities": {
    "Produto": {
      "source": {
        "object": "dbo.produtos",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Produto",
          "plural": "Produtos"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "Aplicacao": {
      "source": {
        "object": "dbo.aplicacoes",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Aplicacao",
          "plural": "Aplicacaos"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "Estoque": {
      "source": {
        "object": "dbo.estoque",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Estoque",
          "plural": "Estoques"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "Cliente": {
      "source": {
        "object": "dbo.clientes",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Cliente",
          "plural": "Clientes"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "PrecoCliente": {
      "source": {
        "object": "dbo.precos_cliente",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "PrecoCliente",
          "plural": "PrecoClientes"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "PecaVeiculo": {
      "source": {
        "object": "dbo.vw_pecas_veiculo",
        "type": "view",
        "key-fields": [
          "sku",
          "montadora",
          "modelo",
          "motorizacao",
          "ano_inicio"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "PecaVeiculo",
          "plural": "PecaVeiculos"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "PrecoFinal": {
      "source": {
        "object": "dbo.vw_preco_cliente",
        "type": "view",
        "key-fields": [
          "codigo_cliente",
          "sku"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "PrecoFinal",
          "plural": "PrecoFinals"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    }
  }
}